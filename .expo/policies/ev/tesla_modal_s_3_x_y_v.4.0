      "charging_curves": {
        "4680_structural_pack": {
          "curve_type": "tesla_optimized_v4_4680",
          "battery_capacity": 95.0,
          "usable_capacity": 90.0,
          "segments": [
            {
              "soc_start": 0,
              "soc_end": 10,
              "max_power": 175000,
              "temperature_factor": 0.7,
              "notes": "Cold battery protection with 4680 warming"
            },
            {
              "soc_start": 10,
              "soc_end": 30,
              "max_power": 350000,
              "temperature_factor": 1.0,
              "notes": "4680 optimized fast ramp"
            },
            {
              "soc_start": 30,
              "soc_end": 50,
              "max_power": 350000,
              "temperature_factor": 1.0,
              "notes": "Peak power sustained with structural cooling"
            },
            {
              "soc_start": 50,
              "soc_end": 70,
              "max_power": 280000,
              "temperature_factor": 1.0,
              "notes": "High efficiency phase"
            },
            {
              "soc_start": 70,
              "soc_end": 80,
              "max_power": 180000,
              "temperature_factor": 0.95,
              "notes": "Cell balancing begins"
            },
            {
              "soc_start": 80,
              "soc_end": 90,
              "max_power": 100000,
              "temperature_factor": 0.9,
              "notes": "Conservative charging for longevity"
            },
            {
              "soc_start": 90,
              "soc_end": 95,
              "max_power": 50000,
              "temperature_factor": 0.85,
              "notes": "CV transition with active balancing"
            },
            {
              "soc_start": 95,
              "soc_end": 100,
              "max_power": 25000,
              "temperature_factor": 0.8,
              "notes": "Top-off with thermal management"
            }
          ],
          "thermal_management": {
            "preconditioning_required": true,
            "active_cooling": true,
            "structural_pack_cooling": true,
            "thermal_limits": {
              "max_cell_temp": 50,
              "min_cell_temp": 0,
              "optimal_temp_range": [20, 35]
            }
          }
        },
        "2170_lfp_pack": {
          "curve_type": "tesla_lfp_optimized",
          "battery_capacity": 60.0,
          "usable_capacity": 57.0,
          "segments": [
            {
              "soc_start": 0,
              "soc_end": 20,
              "max_power": 170000,
              "temperature_factor": 0.8,
              "notes": "LFP cold weather optimization"
            },
            {
              "soc_start": 20,
              "soc_end": 80,
              "max_power": 170000,
              "temperature_factor": 1.0,
              "notes": "LFP flat charging curve advantage"
            },
            {
              "soc_start": 80,
              "soc_end": 100,
              "max_power": 50000,
              "temperature_factor": 0.9,
              "notes": "LFP can charge to 100% daily"
