  },
  "metadata": {
    "name": "Nissan Leaf vlink MS Charging Policy",
    "description": "Enhanced vlink MS compatible charging policy for Nissan Leaf EVs with advanced telemetry and load management",
    "manufacturer": "nissan",
    "policy_type": "production",
    "certification_level": "tier_1",
    "created": "2024-08-22T10:00:00Z",
    "updated": "2024-08-22T15:30:00Z",
