  "metadata": {
    "name": "Hyundai/Kia Enhanced Pre-CFD vlink MS Charging Policy",
    "description": "Advanced vlink MS compatible charging policy for Hyundai/Kia Pre-Charge Flow Diagram architecture EVs with comprehensive thermal management, BlueLink/UVO integration, and battery longevity optimization",
    "manufacturer": "hyundai_motor_group_kia_corporation",
    "policy_type": "production_precfd_comprehensive",
    "certification_level": "tier_1_plus_precfd",
    "created": "2024-08-22T10:00:00Z",
    "updated": "2024-08-22T22:30:00Z",
    "revision": "4.1.0-stable-precfd",
    "build_number": "2024.08.22.2230",
    "checksum": "sha256:b2c3d4e5f6a7890123456789012345678901abcdef2345678901abcdef456789",
    "maintainer": {
      "organization": "hyundai_kia_global_vlink_systems",
      "contact": "precfd-support@vlink.ms",
      "documentation": "https://docs.vlink.ms/policies/hyundai-kia-precfd",
      "support_tier": "premium_precfd"
    },
    "revision_notes": {
      "v4.1.0": "Major update: Enhanced Pre-CFD architecture support, improved thermal management, added IONIQ 6/EV6 support, advanced battery conditioning",
      "v4.0.2": "Added Genesis GV60/GV70 support, improved winter performance, enhanced BlueLink integration",
      "v4.0.1": "IONIQ 5/EV6 initial support, E-GMP platform recognition, 800V architecture optimization"
    },
    "precfd_philosophy": {
      "charge_flow_optimization": "pre_calculation_priority",
      "thermal_first_approach": "battery_protection_paramount",
      "user_experience_focus": "convenience_without_compromise",
      "performance_efficiency": "balanced_optimization"
    },
    "localization": {
      "supported_languages": ["en", "ko", "ja", "de", "fr", "es", "pt", "it", "zh", "hi", "ar", "ru", "tr"],
      "default_language": "en",
      "regional_compliance": ["KR", "US", "CA", "EU", "UK", "AU", "IN", "CN", "JP", "ASEAN", "ME", "RU"]
    }
  },
  "vehicle_identification": {
    "vin_patterns": ["KMH*", "KNA*", "KNM*", "KND*", "KNE*", "KNF*", "KNG*", "KNH*", "KNJ*", "KNK*", "KNL*"],
    "supported_models": [
      // Hyundai Pre-CFD Models
      {"model": "IONIQ_ELECTRIC", "year_range": [2017, 2022], "trim": ["Electric", "Electric_Plus", "Electric_Limited"], "generation": "1", "market": "GLOBAL", "architecture": "Pre-CFD"},
      {"model": "KONA_ELECTRIC", "year_range": [2018, 2023], "trim": ["SE", "SEL", "Limited"], "generation": "1", "market": "GLOBAL", "architecture": "Pre-CFD"},
      {"model": "IONIQ_5", "year_range": [2022, 2025], "trim": ["SE", "SEL", "Limited"], "generation": "1", "market": "GLOBAL", "architecture": "E-GMP_800V"},
      {"model": "IONIQ_6", "year_range": [2023, 2025], "trim": ["SE", "SEL", "Limited"], "generation": "1", "market": "GLOBAL", "architecture": "E-GMP_800V"},
      
      // Kia Pre-CFD Models
      {"model": "NIRO_EV", "year_range": [2019, 2025], "trim": ["S", "EX", "EX_Premium", "SX_Touring"], "generation": "1-2", "market": "GLOBAL", "architecture": "Pre-CFD"},
      {"model": "SOUL_EV", "year_range": [2020, 2023], "trim": ["S", "GT-Line"], "generation": "3", "market": "GLOBAL", "architecture": "Pre-CFD"},
      {"model": "EV6", "year_range": [2022, 2025], "trim": ["Light", "Wind", "GT-Line", "GT"], "generation": "1", "market": "GLOBAL", "architecture": "E-GMP_800V"},
      {"model": "EV9", "year_range": [2024, 2025], "trim": ["Light", "Wind", "Land", "GT-Line"], "generation": "1", "market": "GLOBAL", "architecture": "E-GMP_800V"},
      
      // Genesis Pre-CFD Models
      {"model": "GV60", "year_range": [2022, 2025], "trim": ["Standard", "Advanced", "Performance"], "generation": "1", "market": "GLOBAL", "architecture": "E-GMP_800V"},
      {"model": "GV70_ELECTRIFIED", "year_range": [2023, 2025], "trim": ["Standard", "Advanced", "Prestige"], "generation": "1", "market": "GLOBAL", "architecture": "E-GMP_800V"},
      {"model": "G90_ELECTRIFIED", "year_range": [2024, 2025], "trim": ["Standard", "Prestige"], "generation": "1", "market": "SELECT", "architecture": "E-GMP_800V"}
    ],
    "battery_variants": [
      // Pre-CFD 400V Batteries
      {"capacity": "28kWh", "chemistry": "NCM622", "pack_voltage": 356, "cells": 96, "architecture": "Pre-CFD_400V"},
      {"capacity": "39.2kWh", "chemistry": "NCM622", "pack_voltage": 356, "cells": 96, "architecture": "Pre-CFD_400V"},
      {"capacity": "64kWh", "chemistry": "NCM811", "pack_voltage": 356, "cells": 96, "architecture": "Pre-CFD_400V"},
      
      // E-GMP 800V Batteries
      {"capacity": "58kWh", "chemistry": "NCM811", "pack_voltage": 697, "cells": 192, "architecture": "E-GMP_800V"},
      {"capacity": "77.4kWh", "chemistry": "NCM811", "pack_voltage": 697, "cells": 192, "architecture": "E-GMP_800V"},
      {"capacity": "99.8kWh", "chemistry": "NCM811", "pack_voltage": 697, "cells": 192, "architecture": "E-GMP_800V"}
    ],
    "architecture_detection": {
      "precfd_400v": {
        "voltage_range": [300, 450],
        "max_dc_power": 77000,
        "charging_architecture": "traditional_ccs",
        "thermal_management": "liquid_cooling"
      },
      "egmp_800v": {
        "voltage_range": [550, 850],
        "max_dc_power": 350000,
        "charging_architecture": "ultra_fast_capable",
        "thermal_management": "advanced_heat_pump"
      }
    },
    "identification_priority": [
      "bluelink_uvo_api",
      "genesis_connected_api",
      "vin_decode_enhanced",
      "architecture_detection",
      "battery_pack_signature",
      "can_message_analysis",
      "obd_extended_query",
      "user_input_assisted"
    ]
  },
  "vlink_ms_parameters": {
    "session_management": {
      "max_session_duration": 720,
      "idle_timeout": 240,
      "authentication_required": true,
