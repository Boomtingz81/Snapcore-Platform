  "charging_profile": {
    "ac_charging": {
      "max_current": 32,
      "max_voltage": 240,
      "max_power": 11000,
      "phases": [1, 3],
      "frequency": [50, 60],
      "power_factor": 0.98,
      "efficiency": 0.94,
      "connector_types": ["Type_1_SAE_J1772", "Type_2_IEC_62196"],
      "onboard_charger_variants": {
        "precfd_standard": {"max_power": 7200, "efficiency": 0.92, "vehicles": ["IONIQ", "Kona", "Niro", "Soul"]},
        "precfd_enhanced": {"max_power": 11000, "efficiency": 0.94, "vehicles": ["IONIQ_5", "EV6", "GV60"]},
        "egmp_premium": {"max_power": 11000, "efficiency": 0.95, "vehicles": ["IONIQ_6", "EV9", "GV70"]}
      },
      "charging_optimization": {
        "preconditioning_enabled": true,
        "schedule_based_charging": true,
        "cost_optimization": true,
        "renewable_preference": true
      }
    },
    "dc_charging": {
      "architecture_specific": {
        "precfd_400v": {
          "max_current": 180,
          "max_voltage": 450,
          "max_power": 77000,
          "preconditioning_support": true
        },
        "egmp_800v": {
          "max_current": 350,
          "max_voltage": 850,
          "max_power": 350000,
          "preconditioning_support": true,
          "ultra_fast_capable": true
        }
      },
      "charging_curves": {
        "precfd_conservative": {
          "curve_type": "hyundai_kia_precfd_optimized",
          "temperature_compensation": true,
          "soc_accuracy": 0.5,
          "battery_health_adaptation": true,
          "segments": [
            {
              "soc_start": 0,
              "soc_end": 10,
              "max_power": 45000,
              "ramp_rate": 3000,
              "conditions": ["battery_temp > 5C", "preconditioning_active"],
              "thermal_monitoring": "intensive"
            },
            {
              "soc_start": 10,
              "soc_end": 45,
              "max_power": 77000,
              "ramp_rate": 5000,
              "conditions": ["battery_temp_optimal", "cooling_active"],
              "peak_power_sustained": true
            },
            {
              "soc_start": 45,
              "soc_end": 70,
              "max_power": 62000,
              "ramp_rate": 3000,
              "conditions": ["thermal_management_active"],
              "efficiency_priority": true
            },
            {
              "soc_start": 70,
              "soc_end": 80,
              "max_power": 35000,
              "ramp_rate": 2000,
              "conditions": ["battery_protection_mode"],
              "cell_balancing": "active"
            },
            {
              "soc_start": 80,
              "soc_end": 90,
              "max_power": 18000,
              "ramp_rate": 1200,
              "conditions": ["gentle_charging"],
              "longevity_priority": true
            },
            {
              "soc_start": 90,
              "soc_end": 95,
              "max_power": 9000,
              "ramp_rate": 800,
              "conditions": ["precision_balancing"]
            },
            {
              "soc_start": 95,
              "soc_end": 100,
              "max_power": 4000,
              "ramp_rate": 400,
              "conditions": ["completion_mode"]
            }
          ]
        },
        "egmp_ultra_fast": {
          "curve_type": "hyundai_kia_egmp_800v_optimized",
          "temperature_compensation": true,
          "soc_accuracy": 0.1,
          "battery_health_adaptation": true,
          "voltage_optimization": true,
          "segments": [
            {
              "soc_start": 0,
              "soc_end": 10,
              "max_power": 120000,
              "ramp_rate": 8000,
              "conditions": ["battery_temp > 15C", "800v_mode"],
              "voltage_boost": true
            },
            {
              "soc_start": 10,
              "soc_end": 50,
              "max_power": 240000,
              "ramp_rate": 12000,
              "conditions": ["optimal_thermal_state"],
              "peak_performance": true
            },
            {
              "soc_start": 50,
              "soc_end": 70,
              "max_power": 180000,
              "ramp_rate": 6000,
              "conditions": ["sustained_performance"],
              "efficiency_optimization": true
            },
            {
              "soc_start": 70,
              "soc_end": 80,
              "max_power": 100000,
              "ramp_rate": 4000,
              "conditions": ["battery_protection"],
              "thermal_priority": true
            },
            {
              "soc_start": 80,
              "soc_end": 95,
              "max_power": 50000,
              "ramp_rate": 2000,
              "conditions": ["longevity_mode"]
            },
            {
              "soc_start": 95,
              "soc_end": 100,
              "max_power": 20000,
              "ramp_rate": 1000,
              "conditions": ["completion_precision"]
            }
          ]
        }
      },
      "environmental_adaptation": {
        "winter_performance": {
          "battery_warming": true,
          "preconditioning_aggressive": true,
          "power_derating": {"threshold": -10, "factor": 0.75},
          "heat_pump_coordination": true
        },
        "summer_protection": {
          "thermal_derating": {"threshold": 35, "factor": 0.85},
          "cooling_prioritization": true,
          "charging_pause_threshold": 50
        }
      }
    },
    "bidirectional_charging": {
      "v2l_capability": {
        "egmp_models": true,
        "max_power": 3600,
        "voltage": [120, 240],
        "camping_mode": true,
        "emergency_power": true
      },
      "v2g_future": {
        "hardware_capable": true,
        "software_update_required": true,
        "pilot_programs": ["korea", "europe"]
      }
    }
  },
  "safety_limits": {
    "temperature": {
      "battery_min_c": -30,
      "battery_max_c": 55,
      "derating_threshold_c": 42,
      "emergency_stop_threshold_c": 60,
      "optimal_range": [20, 35],
      "active_thermal_management": {
        "liquid_cooling": true,
        "heat_pump_integration": true,
        "predictive_conditioning": true,
        "cabin_integration": true
      },
      "precfd_thermal_strategy": {
        "conservative_approach": true,
        "battery_protection_priority": true,
        "thermal_runaway_prevention": "comprehensive",
        "cell_level_monitoring": true
      }
    },
    "voltage": {
      "isolation_resistance_min": 500,
      "insulation_monitoring": "continuous",
      "architecture_specific": {
        "precfd_400v": {
          "nominal_voltage": 356,
          "max_voltage": 450,
          "min_voltage": 270,
          "max_cell_voltage": 4.15
        },
        "egmp_800v": {
          "nominal_voltage": 697,
          "max_voltage": 850,
          "min_voltage": 550,
          "max_cell_voltage": 4.2
        }
      },
      "high_voltage_safety": {
        "automatic_disconnect": true,
        "manual_service_disconnect": true,
        "crash_disconnect": true,
        "voltage_monitoring": "real_time"
      }
    },
    "current": {
      "overcurrent_protection": true,
      "ground_fault_detection": true,
      "dc_current_sensor_monitoring": true,
      "arc_fault_detection": true,
      "welding_detection": true,
      "current_imbalance_detection": true
    },
    "mechanical": {
      "connector_insertion_detection": true,
      "lock_verification": true,
      "cable_integrity_check": true,
      "vibration_monitoring": true,
      "impact_detection": true,
      "water_ingress_protection": "IP67"
    }
  },
  "vlink_ms_telemetry": {
    "data_streams": {
      "high_frequency": {
        "interval_ms": 100,
        "parameters": ["voltage", "current", "power", "frequency", "power_factor"],
        "compression": "delta_compression",
        "local_storage_duration": 300
      },
      "medium_frequency": {
        "interval_ms": 1000,
        "parameters": ["soc", "battery_temp_min", "battery_temp_max", "battery_temp_avg", "energy_delivered"],
        "compression": "standard",
        "local_storage_duration": 1800
      },
      "precfd_specific": {
        "interval_ms": 2000,
        "parameters": [
          "charging_efficiency",
          "cell_voltage_delta", 
          "thermal_management_status",
          "preconditioning_status",
          "battery_conditioning_power",
          "heat_pump_status",
          "cooling_system_status",
          "bms_health_score"
        ],
        "compression": "json_compact",
        "local_storage_duration": 3600
      },
      "low_frequency": {
        "interval_ms": 30000,
        "parameters": ["cell_voltages", "cell_temperatures", "degradation_metrics", "cycle_count"],
        "compression": "none",
        "local_storage_duration": 86400
      }
    },
    "analytics": {
      "real_time_processing": true,
      "ml_inference": {
        "battery_degradation_prediction": true,
        "thermal_optimization": true,
        "charging_pattern_learning": true,
        "preconditioning_optimization": true,
        "model_version": "hyundai_kia_ml_v4.1.0"
      },
      "precfd_analytics": {
        "charge_flow_optimization": true,
        "battery_protection_scoring": true,
        "thermal_efficiency_analysis": true,
        "winter_performance_tracking": true
      }
    }
  },
  "error_handling": {
    "fault_tolerance": {
      "retry_attempts": 5,
      "exponential_backoff": true,
      "max_retry_interval": 300,
      "circuit_breaker_threshold": 10,
      "error_recovery_timeout": 60,
