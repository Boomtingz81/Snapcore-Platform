  "metadata": {
    "name": "PSA/Stellantis Pre-CFD Enhanced Charging Policy",
    "description": "Enhanced vlink MS compatible charging policy for PSA/Stellantis pre-Charge Flow Diagram EVs and PHEVs with improved diagnostics and error handling",
    "manufacturer": "stellantis",
    "manufacturer_groups": ["psa", "opel_vauxhall", "fca", "ds_automobiles"],
    "policy_type": "production",
    "created": "2024-01-15T10:00:00Z",
    "updated": "2025-08-25T14:30:00Z",
    "version_notes": "Enhanced error handling, improved diagnostics, extended vehicle support",
    "maintainer": "snapcore_team",
    "certification_level": "tier1_validated"
  },
