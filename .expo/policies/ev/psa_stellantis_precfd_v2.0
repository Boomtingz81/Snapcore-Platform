  "vlink_parameters": {
    "session_management": {
      "max_session_duration": 540,
      "idle_timeout": 360,
      "heartbeat_interval": 30,
      "session_recovery_timeout": 120,
      "authentication_required": true,
      "security_level": "high",
      "app_integrations": {
        "myPeugeot": {"enabled": true, "api_version": "2.1"},
        "myCitroen": {"enabled": true, "api_version": "2.1"},
        "myOpel": {"enabled": true, "api_version": "2.0"},
        "myDS": {"enabled": true, "api_version": "1.9"},
        "uconnect": {"enabled": true, "api_version": "4.0"}
      }
    },
    "communication_stack": {
      "primary_protocol": "ISO15118-2",
      "fallback_protocols": ["DIN70121", "IEC61851-1"],
      "protocol_negotiation_timeout": 45,
      "plug_lock_support": true,
      "cable_check_required": true,
      "pnc_support": false,
      "psa_proprietary_diagnostics": true,
      "diagnostic_protocols": ["UDS_ISO14229", "KWP2000"],
      "security_features": {
        "certificate_validation": true,
        "encrypted_communication": true,
        "replay_protection": true
      }
    }
  },
  "charging_profile": {
    "ac_charging": {
      "single_phase": {
        "max_current": 32,
        "max_voltage": 230,
        "max_power": 7400,
        "frequency": 50,
        "efficiency": 0.92
      },
      "three_phase": {
        "max_current": 32,
        "max_voltage": 400,
        "max_power": 11000,
        "frequency": 50,
        "efficiency": 0.94,
        "phase_balancing": true
      },
      "adaptive_features": {
        "psa_adaptive_charging": true,
        "temperature_compensation": true,
        "grid_frequency_regulation": true,
        "power_factor_correction": 0.95
      }
    },
    "dc_charging": {
      "specifications": {
        "max_current": 125,
        "max_voltage": 500,
        "max_power": 100000,
        "min_voltage": 150,
        "efficiency": 0.96
      },
      "charging_curves": {
        "50kwh_ncm622": {
          "curve_type": "psa_optimized_v2",
          "battery_capacity": 50.0,
          "usable_capacity": 45.0,
          "segments": [
            {
              "soc_start": 0,
              "soc_end": 10,
              "max_power": 50000,
              "temperature_factor": 0.8,
              "notes": "Cold battery protection"
            },
            {
              "soc_start": 10,
              "soc_end": 20,
              "max_power": 78000,
              "temperature_factor": 1.0,
              "notes": "Ramp up phase"
            },
            {
              "soc_start": 20,
              "soc_end": 50,
              "max_power": 100000,
              "temperature_factor": 1.0,
              "notes": "Peak power phase"
            },
            {
              "soc_start": 50,
              "soc_end": 70,
              "max_power": 85000,
              "temperature_factor": 1.0,
              "notes": "High efficiency phase"
            },
            {
              "soc_start": 70,
              "soc_end": 80,
              "max_power": 50000,
              "temperature_factor": 0.95,
              "notes": "Battery protection phase"
            },
            {
              "soc_start": 80,
              "soc_end": 90,
              "max_power": 25000,
              "temperature_factor": 0.9,
              "notes": "CV transition phase"
            },
            {
              "soc_start": 90,
              "soc_end": 100,
              "max_power": 10000,
              "temperature_factor": 0.85,
              "notes": "Top-off phase"
            }
          ],
          "thermal_management": {
            "active_cooling": true,
            "preconditioning": true,
            "thermal_limits": {
              "max_cell_temp": 45,
              "min_cell_temp": 0,
              "derating_threshold": 42
            }
          }
        },
        "17kwh_ncm811": {
          "curve_type": "phev_conservative",
          "battery_capacity": 17.3,
          "usable_capacity": 14.0,
          "dc_charging_disabled": true,
          "ac_only_charging": true
        }
      }
    }
  },
  "safety_systems": {
    "temperature_management": {
      "battery_limits": {
        "min_temp_c": -25,
        "max_temp_c": 50,
        "derating_threshold_c": 45,
        "critical_shutdown_c": 55,
        "hysteresis_c": 2
      },
      "thermal_systems": {
        "active_thermal_management": true,
        "air_cooling_system": true,
        "liquid_cooling_available": false,
        "cabin_heat_pump": true,
        "battery_heater": true,
        "preconditioning_support": true
      }
    },
    "electrical_safety": {
      "voltage_monitoring": {
        "isolation_resistance_min_kohm": 100,
        "insulation_monitoring": true,
        "high_voltage_safety_interlock": true,
        "pyrotechnic_disconnect": true,
        "contactor_redundancy": "dual_redundant"
      },
      "current_protection": {
        "overcurrent_protection": true,
        "ground_fault_detection": true,
        "differential_protection": true,
        "arc_fault_detection": false,
        "short_circuit_protection": true,
        "current_sensor_redundancy": true
      }
    },
    "functional_safety": {
      "safety_integrity_level": "ASIL_C",
      "watchdog_systems": true,
      "fail_safe_mechanisms": true,
      "diagnostic_coverage": 0.95,
      "safety_goals": [
        "prevent_thermal_runaway",
        "prevent_electrical_shock",
        "prevent_fire_hazard",
        "ensure_emergency_shutdown"
      ]
    }
  },
  "vlink_telemetry": {
    "reporting_configuration": {
      "base_interval_ms": 1500,
      "high_frequency_interval_ms": 500,
      "error_burst_interval_ms": 100,
      "data_compression": true,
      "encryption_enabled": true
    },
    "parameter_sets": {
      "standard_telemetry": [
        "soc",
        "soh",
        "voltage_pack",
        "current_pack",
        "power_instantaneous",
        "battery_temp_min",
        "battery_temp_max",
        "battery_temp_avg",
        "ambient_temp",
        "energy_delivered_session",
        "energy_delivered_total",
        "charging_time_elapsed",
        "estimated_time_remaining",
        "range_estimate_wltp",
        "energy_consumption_avg"
      ],
      "diagnostic_telemetry": [
        "cell_voltages",
        "cell_temperatures",
        "contactor_status",
        "isolation_resistance",
        "bms_status",
        "charger_status",
        "thermal_system_status",
        "dtc_active_count",
        "dtc_pending_count"
      ],
      "safety_telemetry": [
        "emergency_stop_status",
        "ground_fault_detected",
        "overcurrent_events",
        "temperature_warnings",
        "insulation_warnings",
        "safety_interlock_status"
      ]
    }
  },
  "error_handling": {
    "retry_strategies": {
      "communication_errors": {
        "max_attempts": 3,
        "backoff_strategy": "exponential",
        "initial_delay_ms": 1000,
        "max_delay_ms": 10000
      },
      "charging_errors": {
        "max_attempts": 2,
        "backoff_strategy": "linear",
        "initial_delay_ms": 5000
      },
      "safety_errors": {
        "max_attempts": 1,
        "immediate_shutdown": true,
        "manual_reset_required": true
      }
    },
    "error_recovery": {
      "timeout_ms": 45000,
      "auto_recovery_enabled": true,
      "recovery_procedures": {
        "communication_lost": "restart_session",
        "overcurrent_detected": "reduce_power_retry",
        "overtemperature": "cool_down_wait",
        "ground_fault": "immediate_stop"
      }
    },
    "diagnostic_protocols": {
      "psa_diagnostic_enabled": true,
      "stellantis_global_diagnostics": true,
      "uds_support": true,
      "kwp2000_legacy_support": true
    }
  },
  "load_management": {
    "grid_integration": {
      "priority_level": "normal",
      "load_balancing_support": true,
      "demand_response_capable": false,
