            "taper_aggressive": true
          },
          {
            "soc_start": 90,
            "soc_end": 100,
            "max_power": 25000,
            "precision_charging": true
          }
        ],
        "advanced_features": {
          "preconditioning_optimization": true,
          "route_based_conditioning": true,
          "predictive_thermal_management": true,
          "machine_learning_curves": true,
          "real_time_adaptation": true
